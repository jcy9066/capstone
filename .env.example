SERVER_HOST=0.0.0.0
SERVER_PORT=21063
SERVER_BASE_URL=http://100.100.248.122:21063
ROBOT_ID=pi-01

STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=15
STREAM_INFER=false
STREAM_RETRY_SEC=3

NAV_DRY_RUN_ENABLED=true
MOTOR_OUTPUT_ENABLED=false
NAV_STOP_DISTANCE_M=0.45
NAV_SLOW_DISTANCE_M=0.90
NAV_NORMAL_LINEAR_MPS=0.25
NAV_SLOW_LINEAR_MPS=0.10
NAV_TURN_ANGULAR_RPS=0.65

# MySQL dabom database. Never commit real credentials in .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dabom
DB_USER=dabom_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT_SEC=5

# Project-owned no-reply SMTP account.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Dabom no-reply
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SEC=10

# Authentication and verification security.
SESSION_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=true
EMAIL_VERIFICATION_SECRET=replace-with-a-different-long-random-secret
EMAIL_VERIFICATION_TTL_SEC=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SEC=60
NAV_SCAN_TIMEOUT_SEC=1.0
