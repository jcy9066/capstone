# Server endpoints and robot identity. Replace deployment-specific placeholders.
SERVER_HOST=0.0.0.0
SERVER_PORT=21063
SERVER_BASE_URL="http://<server-ip>:21063"
ROBOT_ID="<robot-id>"
ROBOT_CONTROL_TOKEN="<robot-control-token>"
COMMAND_WS_URL="ws://<server-ip>:21063/ws/robot/<robot-id>"

# Camera input, frame transport, and dashboard stream.
RTSP_URL="<rtsp-or-camera-source>"
FRAME_FPS=10
FRAME_WIDTH=640
FRAME_HEIGHT=480
JPEG_QUALITY=70
STREAM_WIDTH=640
STREAM_HEIGHT=480
STREAM_FPS=15
STREAM_BITRATE=1000000
STREAM_INFER=false
STREAM_RETRY_SEC=3
STREAM_JPEG_QUALITY=75
PREVIEW_MAX_FPS=15
SAVE_RECEIVED_FRAMES=false
STATUS_INTERVAL_SEC=1.0
WS_RECONNECT_DELAY_SEC=1.0
CURL_CONNECT_TIMEOUT_SEC=5
CAMERA_TIMEOUT_SEC=3.0
ROBOT_STATUS_TIMEOUT_SEC=5.0

# Model pipeline, GPU, and inference scheduling.
PIPELINE=1
MODEL_REQUIRED=false
INFERENCE_ENABLED=true
VISUALIZATION_ENABLED=true
STREAM_INFER_EVERY_N=1
INFERENCE_MAX_FPS=15
ADAPTIVE_BATCHING_ENABLED=true
ADAPTIVE_BATCH_MAX_WAIT_MS=8
ACTION_DISPLAY_TTL_SEC=1.0
TRIGGER_SUSPICIOUS_VISUAL_ENABLED=true
INFERENCE_MAX_RESULT_AGE_SEC=3.0
INFERENCE_DROP_OLDER_THAN_SEC=2.0
CUDA_DEVICE_INDEX=0
DEVICE=cuda:0
GPU_REQUIRED_FOR_INFERENCE=true
ENV_RELOAD_CHECK_INTERVAL_SEC=1.0

# Detection thresholds and temporal violence heuristic.
ACTION_SUSPICIOUS_THRESHOLD=0.20
ACTION_DANGER_THRESHOLD=0.50
SPATIAL_THRESHOLD_IOU=0.1
SPATIAL_THRESHOLD_DIST=150.0
TEMPORAL_THRESHOLD_FRAMES=5
VIOLENCE_HEURISTIC_ENABLED=true
VIOLENCE_HEURISTIC_USE_LEG_STRIKES=false
VIOLENCE_HEURISTIC_USE_BOX_TARGET_POINTS=false
VIOLENCE_HEURISTIC_HISTORY_FRAMES=12
VIOLENCE_HEURISTIC_SUSPICIOUS_FRAMES=3
VIOLENCE_HEURISTIC_DANGER_FRAMES=4
VIOLENCE_HEURISTIC_MOTION_THRESHOLD=0.07
VIOLENCE_HEURISTIC_APPROACH_THRESHOLD=0.035
VIOLENCE_HEURISTIC_PROXIMITY_THRESHOLD=0.36
VIOLENCE_HEURISTIC_PAIR_DISTANCE_THRESHOLD=1.45
VIOLENCE_HEURISTIC_SUSPICIOUS_SCORE=0.34
VIOLENCE_HEURISTIC_DANGER_SCORE=0.48

# Status persistence and event alert timing.
SYSTEM_STATUS_INTERVAL_SEC=5
EVENT_SAVE_COOLDOWN_SEC=10
TELEGRAM_ALERT_COOLDOWN_SEC=10

# Navigation behavior, process control, and safety watchdogs.
NAV_DRY_RUN_ENABLED=true
NAVIGATION_DEFAULT_MODE=MAPPING
NAVIGATION_TIMEOUT_SEC=3.0
NAV_SERVER_BASE_URL="http://<server-ip>:21063"
NAV_STOP_DISTANCE_M=0.45
NAV_SLOW_DISTANCE_M=0.90
NAV_NORMAL_LINEAR_MPS=0.25
NAV_SLOW_LINEAR_MPS=0.10
NAV_TURN_ANGULAR_RPS=0.65
NAV_SCAN_TIMEOUT_SEC=1.0
NAV_PROCESS_START_TIMEOUT_SEC=1.0
NAV_PROCESS_STOP_TIMEOUT_SEC=2.0
NAV_DRIVING_READY_TIMEOUT_SEC=15.0
NAV_COMPUTE_PATH_TIMEOUT_SEC=10.0
NAV_CANCEL_TIMEOUT_SEC=3.0
NAV_CANCEL_RESULT_TIMEOUT_SEC=3.0
NAV_WATCHDOG_INTERVAL_SEC=0.25
NAV_WATCHDOG_LIDAR_TIMEOUT_SEC=1.5
NAV_WATCHDOG_ODOM_TIMEOUT_SEC=1.0
NAV_WATCHDOG_TF_TIMEOUT_SEC=1.0
NAV_WATCHDOG_TF_SOURCE_MAX_AGE_SEC=1.0
NAV_WATCHDOG_LOCALIZATION_TIMEOUT_SEC=2.0
NAV_WATCHDOG_PI_TIMEOUT_SEC=3.0
NAV_WATCHDOG_STOP_ENCODER_GRACE_SEC=0.35
NAV_WATCHDOG_STOP_ENCODER_TICKS=4
ROBOT_COMMAND_ACK_TIMEOUT_SEC=2.0

# ROS 2, LiDAR, encoder, and wheel odometry.
ROS_DOMAIN_ID=27
ROS_LOCALHOST_ONLY=1
LIDAR_ENABLE=true
LIDAR_ROS_TOPIC=/scan
LIDAR_SCAN_TOPIC=/scan
LIDAR_BASE_FRAME=base_link
LIDAR_FRAME=laser
LIDAR_X=0.0
LIDAR_Y=0.0
LIDAR_Z=0.12
LIDAR_YAW=0.0
LIDAR_DASHBOARD_MAX_POINTS=360
LIDAR_USE_SOURCE_TIMESTAMP=true
LIDAR_WS_URL="ws://<server-ip>:21063/ws/sensors/<robot-id>/lidar"
LIDAR_WS_RECONNECT_SEC=1.0
LIDAR_SERIAL_PORT=/dev/ttyUSB0
LIDAR_SERIAL_BAUDRATE=115200
LIDAR_DRIVER_PACKAGE=sllidar_ros2
LIDAR_DRIVER_EXECUTABLE=sllidar_node
ENCODER_ROS_ENABLE=true
ENCODER_ROS_TOPIC=/wheel_ticks
WHEEL_DIAMETER_M=0.0675
WHEEL_TRACK_M=0.201
ENCODER_TICKS_PER_REV=14289.848
WHEEL_TICKS_TOPIC=/wheel_ticks
ODOM_TOPIC=/odom
ODOM_FRAME=odom
BASE_FRAME=base_link
ODOMETRY_ENCODER_TIMEOUT_SEC=0.25

# Raspberry Pi UART motor client and failsafe timing.
MOTOR_SERIAL_PORT=/dev/serial0
MOTOR_SERIAL_BAUDRATE=115200
MOTOR_SERIAL_TIMEOUT_SEC=0.25
COMMAND_TIMEOUT_SEC=0.45
MAX_WHEEL_MPS=0.50
ENCODER_INTERVAL_SEC=0.05

# MySQL connection. Never commit real database credentials.
DB_HOST="<db-host>"
DB_PORT=3306
DB_NAME="<db-name>"
DB_USER="<db-user>"
DB_PASSWORD="<db-password>"
DB_CONNECT_TIMEOUT_SEC=5

# Telegram alerts. Keep bot credentials out of version control.
TELEGRAM_TOKEN="<telegram-bot-token>"
TELEGRAM_CHAT_ID="<telegram-chat-id>"

# Project-owned no-reply SMTP account.
SMTP_HOST="<smtp-host>"
SMTP_PORT=587
SMTP_USERNAME="<smtp-username>"
SMTP_PASSWORD="<smtp-password>"
SMTP_FROM_EMAIL="<smtp-from-email>"
SMTP_FROM_NAME="Dabom no-reply"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SEC=10

# Session, email verification, and authentication rate limits.
SESSION_SECRET_KEY="<session-secret>"
COOKIE_SECURE=true
EMAIL_VERIFICATION_SECRET="<email-verification-secret>"
EMAIL_VERIFICATION_TTL_SEC=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SEC=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_MAX_SENDS=5
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SEC=600
